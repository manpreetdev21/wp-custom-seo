{
	"name": "manpreet-singh/wp-custom-seo",
	"description": "Modern SEO management for WordPress with an AI assistant.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Manpreet Singh"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"WPCustomSeo\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "@php -l wp-custom-seo.php",
		"cs": "phpcs",
		"cbf": "phpcbf",
		"test": "@php tests/self-check.php",
		"i18n": "wp i18n make-pot . languages/wp-custom-seo.pot --exclude=vendor,tests,node_modules --domain=wp-custom-seo"
	}
}
