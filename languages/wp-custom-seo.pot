msgstr[1] ""

#: src/Audit/Auditor.php:343
msgid "Without one, a search engine writes its own summary from whatever text it finds. That is sometimes fine and sometimes a navigation menu."
msgstr ""

#: src/Audit/Auditor.php:344
msgid "Write descriptions in the bulk editor, filtering by “Missing meta description”."
msgstr ""

#: src/Audit/Auditor.php:353
msgid "Every published page has a meta description."
msgstr ""

#: src/Audit/Auditor.php:354
msgid "You control the summary shown under each result."
msgstr ""

#. translators: %d: number of pages.
#: src/Audit/Auditor.php:365
#, php-format
msgid "%d published page has no focus keyphrase."
msgid_plural "%d published pages have no focus keyphrase."
msgstr[0] ""
msgstr[1] ""

#: src/Audit/Auditor.php:368
msgid "The keyphrase is what the editor analysis measures against. Without one, most of the on-page checks have nothing to compare to — the page is not worse off, but you get less feedback on it."
msgstr ""

#: src/Audit/Auditor.php:369
msgid "Set one on the pages that matter most. It is not worth doing for every page on a large site."
msgstr ""

#: src/Audit/Auditor.php:387
#: templates/admin/bulk-editor.php:79
#: templates/admin/bulk-editor.php:111
#: templates/admin/meta-box.php:107
