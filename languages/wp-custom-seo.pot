msgstr ""

#: src/Audit/Auditor.php:267
msgid "Check the list in the bulk editor and clear noindex on anything that should be findable."
msgstr ""

#. translators: %d: number of pages.
#: src/Audit/Auditor.php:278
#, php-format
msgid "%d published pages are set to noindex."
msgstr ""

#: src/Audit/Auditor.php:281
