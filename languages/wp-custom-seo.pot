msgstr ""

#. translators: 1: number of pages, 2: field name.
#: src/Audit/Auditor.php:409
#, php-format
msgid "%1$d pages share a %2$s with another page."
msgstr ""

#: src/Audit/Auditor.php:413
msgid "Identical text on several pages gives a searcher no way to tell them apart, and gives a search engine a reason to treat them as the same page."
msgstr ""

#: src/Audit/Auditor.php:414
msgid "Rewrite the duplicates so each says what is specific to that page."
msgstr ""

#. translators: %d: number of pages.
#: src/Audit/Auditor.php:448
#, php-format
msgid "%d page competes with another for its keyphrase."
msgid_plural "%d pages compete with each other for a keyphrase."
msgstr[0] ""
msgstr[1] ""

#: src/Audit/Auditor.php:456
msgid "When two of your own pages target one phrase, a search engine has to choose between them and may pick the weaker one, or split the signal across both. Word order and plurals are ignored here, so \"roof insulation\" and \"insulation for roofs\" count as the same target."
msgstr ""

#: src/Audit/Auditor.php:457
msgid "For each clash: merge the pages, change one keyphrase, canonicalise one to the other, or make the intents genuinely different."
msgstr ""

#. translators: %d: number of pages.
#: src/Audit/Auditor.php:491
#, php-format
msgid "%d published page has no internal links pointing at it."
msgid_plural "%d published pages have no internal links pointing at them."
msgstr[0] ""
msgstr[1] ""

#: src/Audit/Auditor.php:494
msgid "A page nothing links to is reachable only through the sitemap or a direct URL. Pages in a navigation menu, the front page and the posts page are excluded here, so these are genuinely unreferenced."
msgstr ""

#: src/Audit/Auditor.php:495
msgid "Link to them from related content where the reference actually helps a reader."
msgstr ""

#. translators: %d: number of links.
#: src/Audit/Auditor.php:510
